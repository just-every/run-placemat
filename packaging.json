{
  "schema": 1,
  "project": {
    "schema": 1,
    "projectId": "just-every/run-placemat",
    "name": "Placemat",
    "sourceRepository": "https://github.com/just-every/run-placemat",
    "license": "MIT",
    "deployment": {
      "target": "cloudflare-workers",
      "artifactFile": "rer-worker-artifact.json"
    },
    "operations": {
      "setup": "pnpm install --frozen-lockfile && pnpm run deps",
      "build": "pnpm run build",
      "verify": "pnpm run verify && pnpm exec rer check --profile first-party && pnpm check:deployment-spec && node scripts/edition-authoring/cli.mjs check && node scripts/edition-authoring/cli.mjs verify-base --offline",
      "artifact": "node scripts/delivery/base/cli.mjs artifact --config packaging.json",
      "recovery": "Follow OPERATIONS.md. Pause writes, retain exact source and private settings, export a consistent Placemat archive, restore only into an empty installation, run owner setup and compare a fresh export before routing traffic. Preserve every applied migration name and byte."
    },
    "verification": {
      "migrationDirectories": [
        "migrations/core"
      ]
    }
  },
  "managed": {
    "workflowRef": "runeditrun/delivery/.github/workflows/trusted-build.yml@ff70d729948753ffdcceeca94aad063af2dcd979",
    "artifactFile": "rer-worker-artifact.json",
    "buildProfile": "project",
    "verificationProfiles": [
      "full"
    ]
  },
  "setup": {
    "manifestFile": "rer-setup.json"
  },
  "artifact": {
    "specInputs": {
      "publicVariableNames": [
        "AUTH_ORIGIN",
        "AUTH_LOCAL",
        "MAIL_PROVIDER",
        "MAIL_FROM",
        "MAIL_RELAY_URL",
        "MAIL_ACCOUNT_ID",
        "IDENTITY_PROVIDER",
        "HOST_PIN_PEPPER_VERSION",
        "OWNER_EMAIL"
      ],
      "secretNames": [
        "SESSION_SECRET",
        "SETUP_TOKEN",
        "HOST_PIN_PEPPER_V1"
      ],
      "optionalSecretNames": [
        "MAIL_API_KEY",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "HOST_PIN_PEPPERS"
      ],
      "healthPath": "/health",
      "recovery": "Follow OPERATIONS.md. Pause writes, retain exact source and private settings, export a consistent Placemat archive, restore only into an empty installation, run owner setup and compare a fresh export before routing traffic. Preserve every applied migration name and byte.",
      "providerEffects": [
        "outbound-mail",
        "payments",
        "analytics"
      ],
      "surfaces": {
        "app": {
          "path": "/signin",
          "originVariable": "AUTH_ORIGIN",
          "signIn": {
            "path": "/signin",
            "loginHint": false
          }
        }
      },
      "mail": {
        "providers": [
          "rer",
          "resend",
          "sendgrid",
          "cloudflare"
        ]
      }
    }
  }
}
