{
  "push": [
    {
      "name": "source",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run check --profile first-party"
      ]
    },
    {
      "name": "api",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run test:api"
      ]
    },
    {
      "name": "site",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run test:site"
      ]
    },
    {
      "name": "runtime",
      "browser": true,
      "hosted": true,
      "commands": [
        "pnpm run build",
        "pnpm run typecheck",
        "pnpm run test:runtime",
        "node tests/floor-ui.mjs",
        "node tests/queue-ui.mjs",
        "node tests/search-ui.mjs",
        "node tests/combinations-ui.mjs",
        "node tests/floor-plan-ui.mjs",
        "node tests/staffing-ui.mjs",
        "node tests/pacing-ui.mjs",
        "node tests/performance-ui.mjs",
        "node tests/risk-ui.mjs",
        "node tests/allocation-ui.mjs",
        "node tests/inquiries-ui.mjs"
      ]
    }
  ],
  "nightly": [
    {
      "name": "installer",
      "browser": true,
      "hosted": false,
      "commands": [
        "pnpm run test:site",
        "pnpm run test:install"
      ]
    }
  ]
}
