{
  "push": [
    {
      "name": "source",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run check --profile first-party",
        "node src/base/contract-docs.mjs check"
      ]
    },
    {
      "name": "api-1",
      "browser": false,
      "hosted": false,
      "commands": [
        "node scripts/test-api-shard.mjs 1"
      ]
    },
    {
      "name": "api-2",
      "browser": false,
      "hosted": false,
      "commands": [
        "node scripts/test-api-shard.mjs 2"
      ]
    },
    {
      "name": "site",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run test:site"
      ]
    },
    {
      "name": "runtime",
      "browser": true,
      "hosted": true,
      "commands": [
        "pnpm run build",
        "pnpm run typecheck",
        "pnpm run test:runtime",
        "PLACEMAT_FLOOR_ONLY=existing node tests/floor-ui.mjs",
        "node tests/queue-ui.mjs",
        "node tests/search-ui.mjs",
        "node tests/combinations-ui.mjs",
        "node tests/floor-plan-ui.mjs",
        "node tests/staffing-ui.mjs",
        "node tests/pacing-ui.mjs",
        "node tests/performance-ui.mjs",
        "node tests/risk-ui.mjs",
        "node tests/allocation-ui.mjs"
      ]
    },
    {
      "name": "runtime-ui",
      "browser": true,
      "hosted": false,
      "commands": [
        "node tests/inquiries-ui.mjs",
        "node tests/business-export-ui.mjs",
        "node tests/service-changes-ui.mjs",
        "node tests/service-close-report-ui.mjs",
        "node tests/embed-ui.mjs",
        "node tests/server-ui.mjs",
        "node tests/audit-ui.mjs",
        "node tests/preshift-ui.mjs",
        "node tests/service-notes-ui.mjs",
        "node tests/timeline-search-ui.mjs",
        "node tests/onboarding-ui.mjs",
        "node tests/guest-review-ui.mjs",
        "node tests/schedules-ui.mjs",
        "node tests/privacy-ui.mjs",
        "node tests/costs-ui.mjs",
        "node tests/experiences-ui.mjs"
      ]
    },
    {
      "name": "shared-hoststand",
      "browser": true,
      "hosted": false,
      "commands": [
        "PLACEMAT_FLOOR_ONLY=hoststand node tests/floor-ui.mjs",
        "node tests/group-ui.mjs",
        "node tests/finance-ui.mjs",
        "node tests/diner-ui.mjs"
      ]
    }
  ],
  "nightly": [
    {
      "name": "installer",
      "browser": true,
      "hosted": false,
      "commands": [
        "pnpm run test:site",
        "pnpm run test:install"
      ]
    }
  ]
}
